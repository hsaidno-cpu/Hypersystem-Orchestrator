# Copy to .env and replace every CHANGE_ME value.
# Never commit the real .env file or put credentials in GitHub Issues/PRs.

# Pin the verified upstream release. Review newer security releases before upgrading.
LOKALBOARDS_VERSION=0.43.0

# Bind only to loopback; terminate public HTTPS at a reverse proxy on this host.
LOKALBOARDS_BIND_ADDRESS=127.0.0.1
NUXT_BOARDS_URL=https://boards.example.com

# First administrator; used only while the instance has no administrator.
NUXT_ADMIN_EMAIL=admin@example.invalid
NUXT_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Dedicated MySQL application password. Generate a strong random value.
MYSQL_PASSWORD=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_PASSWORD

# "auto" is suitable when the reverse proxy connects from loopback/private network.
# Adjust to the actual trusted proxy count/topology if it differs.
NUXT_TRUST_PROXY=auto

# Optional SMTP. Configure before relying on invitations or password-reset e-mail.
# NUXT_EMAIL_HOST=
# NUXT_EMAIL_PORT=465
# NUXT_EMAIL_SECURE=true
# NUXT_EMAIL_USER=
# NUXT_EMAIL_PASS=
