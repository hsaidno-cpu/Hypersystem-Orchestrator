{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hypersystem Source and Rights Registry",
  "type": "object",
  "required": ["schema_version", "registry_revision", "authority", "counts", "policy", "rights_status_definitions", "records"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_revision": {"type": "string", "format": "date"},
    "authority": {"type": "string", "minLength": 1},
    "counts": {
      "type": "object",
      "required": ["plugin_identity_count", "official_pinned_source_count", "not_identified_git_source_count", "candidate_incomplete_count", "legacy_redirect_count", "currently_installable_count"],
      "properties": {
        "plugin_identity_count": {"type": "integer", "minimum": 1},
        "official_pinned_source_count": {"type": "integer", "minimum": 0},
        "not_identified_git_source_count": {"type": "integer", "minimum": 0},
        "candidate_incomplete_count": {"type": "integer", "minimum": 0},
        "legacy_redirect_count": {"type": "integer", "minimum": 0},
        "currently_installable_count": {"type": "integer", "minimum": 0}
      }
    },
    "policy": {"type": "array", "items": {"type": "string"}},
    "rights_status_definitions": {"type": "object"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["plugin_key", "display_name", "platform_package_version", "source_state", "source_repository_id", "source", "rights", "distribution", "migration"],
        "properties": {
          "plugin_key": {"type": "string"},
          "display_name": {"type": "string"},
          "platform_package_version": {"type": ["string", "null"]},
          "source_state": {"enum": ["integrated_submodule", "candidate_repository", "pending_repository", "canonical_redirect"]},
          "source_repository_id": {"type": ["string", "null"]},
          "source": {
            "type": "object",
            "required": ["kind", "repository_url", "visibility", "verification_state"],
            "properties": {
              "kind": {"enum": ["canonical", "candidate", "not_identified", "legacy_redirect"]},
              "repository_url": {"type": ["string", "null"]},
              "repository_id": {"type": ["string", "null"]},
              "visibility": {"enum": ["PUBLIC", "PRIVATE", "NOT_IDENTIFIED"]},
              "default_branch": {"type": ["string", "null"]},
              "observed_head_sha": {"type": ["string", "null"]},
              "parent_pinned_commit": {"type": ["string", "null"]},
              "verification_state": {"type": "string"}
            }
          },
          "rights": {
            "type": "object",
            "required": ["license_id", "license_status", "rights_state", "commercial_use", "redistribution_rule", "rights_evidence"],
            "properties": {
              "license_id": {"type": ["string", "null"]},
              "license_status": {"type": "string"},
              "license_file_path": {"type": ["string", "null"]},
              "license_evidence_url": {"type": ["string", "null"]},
              "required_notice_path": {"type": ["string", "null"]},
              "required_notice_url": {"type": ["string", "null"]},
              "rights_state": {"type": "string"},
              "commercial_use": {"type": "string"},
              "redistribution_rule": {"type": "string"},
              "rights_evidence": {"type": "array", "items": {"type": "string"}}
            }
          },
          "distribution": {
            "type": "object",
            "required": ["status", "license_status", "blockers", "eligible_for_redistribution"],
            "properties": {
              "status": {"type": "string"},
              "license_status": {"type": "string"},
              "blockers": {"type": "array", "items": {"type": "string"}},
              "eligible_for_redistribution": {"type": "boolean"}
            }
          },
          "migration": {
            "type": "object",
            "required": ["status", "owner_action_required", "next_actions"],
            "properties": {
              "status": {"type": "string"},
              "owner_action_required": {"type": "string"},
              "next_actions": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
