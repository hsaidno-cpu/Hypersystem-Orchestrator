{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/hsaidno-cpu/Hypersystem-Orchestrator/blob/main/contracts/hso-runtime-workflow.schema.json",
  "title":"HSO Runtime Workflow",
  "description":"A supervised, deny-by-default workflow for the currently supported isolated sandbox runtime.",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","case_id","requested_by","action_authority","environment","work_packages"],
  "properties":{
    "schema_version":{"const":"1.0.0"},
    "case_id":{"type":"string","minLength":3,"maxLength":128},
    "requested_by":{"type":"string","minLength":1,"maxLength":128},
    "action_authority":{"enum":["S0","S1","S2","S3","S4","S5"]},
    "environment":{"enum":["SANDBOX","STAGING","PRODUCTION"]},
    "work_packages":{
      "type":"array","minItems":1,"maxItems":50,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["package_id","task_type","action_id","target_path","input","depends_on","idempotency_key","expected_sha256","max_attempts","recovery"],
        "properties":{
          "package_id":{"type":"string","minLength":1,"maxLength":128},
          "task_type":{"type":"string","minLength":1,"maxLength":128},
          "action_id":{"type":"string","minLength":1,"maxLength":128},
          "target_path":{"type":"string","minLength":1,"maxLength":512},
          "input":{"type":"object"},
          "depends_on":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
          "idempotency_key":{"type":"string","minLength":8,"maxLength":256},
          "expected_sha256":{"type":"string","pattern":"^[A-Fa-f0-9]{64}$"},
          "max_attempts":{"type":"integer","minimum":1,"maximum":3},
          "recovery":{
            "type":"object","additionalProperties":false,
            "required":["on_action_failure","on_verification_failure"],
            "properties":{
              "on_action_failure":{"enum":["NONE","ROLLBACK_IF_CREATED"]},
              "on_verification_failure":{"enum":["NONE","ROLLBACK_IF_CREATED"]}
            }
          },
          "approval_receipt":{"type":["object","null"]}
        }
      }
    }
  }
}