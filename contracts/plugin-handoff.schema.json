{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hsaidno-cpu/Hypersystem-Orchestrator/blob/main/contracts/plugin-handoff.schema.json",
  "title": "Hypersystem Plugin Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["handoff_id", "case_id", "source_plugin", "recipient_plugin", "intent", "scope", "epistemic_status", "capability_status", "expected_output", "acceptance_criteria"],
  "properties": {
    "handoff_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "source_plugin": {"type": "object", "required": ["plugin_key", "version_or_commit"], "properties": {"plugin_key": {"type": "string"}, "version_or_commit": {"type": "string"}}},
    "recipient_plugin": {"type": "object", "required": ["plugin_key", "contract_version"], "properties": {"plugin_key": {"type": "string"}, "contract_version": {"type": "string"}}},
    "intent": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "items": {"type": "string"}},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "inputs": {"type": "array", "items": {"type": "object", "required": ["locator", "provenance"], "properties": {"locator": {"type": "string"}, "provenance": {"type": "string"}, "sensitivity": {"type": "string"}}}},
    "findings": {"type": "array", "items": {"type": "object", "required": ["id", "status", "summary"], "properties": {"id": {"type": "string"}, "status": {"enum": ["OBSERVED", "VERIFIED_SOURCE", "USER_CLAIM", "SOURCE_CLAIM", "ASSUMPTION", "INFERENCE", "HYPOTHESIS", "UNKNOWN"]}, "summary": {"type": "string"}}}},
    "epistemic_status": {"type": "array", "items": {"enum": ["OBSERVED", "VERIFIED_SOURCE", "USER_CLAIM", "SOURCE_CLAIM", "ASSUMPTION", "INFERENCE", "HYPOTHESIS", "UNKNOWN"]}},
    "capability_status": {"enum": ["READY", "READY_WITH_LIMITATIONS", "NOT_CHECKED", "UNAVAILABLE", "ACCESS_DENIED", "EXPIRED", "BLOCKED", "OUT_OF_SCOPE"]},
    "authority": {"type": "object", "properties": {"level": {"type": "string"}, "approval_reference": {"type": "string"}}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "expected_output": {"type": "string", "minLength": 1},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "risk_and_unknowns": {"type": "array", "items": {"type": "string"}},
    "completion_status": {"enum": ["NOT_STARTED", "IN_PROGRESS", "PARTIAL", "BLOCKED", "READY_FOR_HANDOFF", "VERIFIED", "FAILED"]}
  }
}