{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hsaidno-cpu/Hypersystem-Orchestrator/blob/main/contracts/hso-p0-skill-invocation-result.schema.json",
  "title": "HSO P0 SKILL ANALYZER Remote MCP Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "command",
    "route",
    "loaded_skills",
    "provider",
    "model",
    "execution_status",
    "tool_execution_status",
    "usage",
    "result"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "command": {
      "const": "analyze"
    },
    "route": {
      "type": "object",
      "required": [
        "id",
        "primary_skills",
        "supporting_skills",
        "engines"
      ],
      "properties": {
        "id": {
          "const": "analyze"
        },
        "primary_skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supporting_skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "engines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "loaded_skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "execution_status": {
      "const": "MODEL_RESPONSE_RECEIVED"
    },
    "tool_execution_status": {
      "const": "NOT_CONFIGURED"
    },
    "usage": {
      "type": "object"
    },
    "result": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60000
    }
  }
}
